# OpenRouter-Zugang. Der Key steht nur hier, nie im Repo.
OPENROUTER_API_KEY=

# Modell-Routing liegt in model.json (primary/fallback/dev, kein Secret):
# - Default ist dev (Free-Modell, unbegrenzt): nvidia/nemotron-3.5-super-vl:free
# - Messlauf mit GLM: AIQUARIUM_DEV=0 (dann greift primary: z-ai/glm-5.3-flash)
# - Einzelne Slots überstimmen: AIQUARIUM_MODEL (statt primary),
#   AIQUARIUM_FALLBACK_MODEL, AIQUARIUM_DEV_MODEL
# AIQUARIUM_DEV=0
# AIQUARIUM_MODEL=z-ai/glm-5.3-flash
# PORT=3077
# Nur setzen, wenn die Datenbank woanders liegen soll.
# Standard: ~/.local/share/aiquarium/world.sqlite (absichtlich außerhalb des syncenden Ordners)
# AIQUARIUM_DB=/pfad/zu/world.sqlite
