# OpenRouter-Zugang. Der Key steht nur hier, nie im Repo.
OPENROUTER_API_KEY=

# Optional: Modell und Port überschreiben
# AIQUARIUM_MODEL=google/gemma-4-26b-a4b-it
# PORT=3077
# Nur setzen, wenn die Datenbank woanders liegen soll.
# Standard: ~/.local/share/aiquarium/world.sqlite (absichtlich außerhalb des syncenden Ordners)
# AIQUARIUM_DB=/pfad/zu/world.sqlite
